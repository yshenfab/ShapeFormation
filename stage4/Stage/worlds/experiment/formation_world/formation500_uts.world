# Generated qualitative formation world. Keep separate from fixed-density statistics.
# FORMATION_ARENA_SIDE controls target generation; the physical world may be larger for padding.
include "formation.inc"
include "map.inc"

speedup -1
interval_sim 100
paused 1
resolution 0.02
threads 1

window
(
  size [900 900]
  scale 3.000000
  center [0 0]
  rotate [0 0]
  show_data 0
)

floorplan
(
  name "empty"
  size [300.000000 300.000000 0.800]
  pose [0 0 0 0]
  bitmap "bitmaps/empty.png"
)

define flocker pioneer2dx_no_sonar
(
  color "black"
  ctrl "formation"
  fiducial_return 1
  fiducial(range_min 0.0 range_max 12.0 range_max_id 12.0 fov 360)
)

