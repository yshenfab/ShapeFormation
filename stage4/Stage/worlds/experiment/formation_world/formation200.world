include "formation.inc"
include "map.inc"

speedup -1
interval_sim 100 # 100ms between updates
paused 1
resolution 0.02 # low resolution gives fast raytracing
threads 20

# configure the GUI window
window
(
  size [1000.000 1000.000] # in pixels
  scale 4.6 # pixels per meter
  # optimum value for the scale is window_size/floorplan_size and it should be rounded downwards
  center [0.000 0.000]
  rotate [0.000 0.000]
  show_data 0
)

floorplan
(
  name "empty"
  size [205.000 205.000 5.000]
  pose [0 0 0 0]
  bitmap "bitmaps/empty.png"
)

define flocker pioneer2dx_front_sonar
(
  color "black"
  ctrl "formation"
  fiducial_return 1
  # fiducial fov in degrees not in radians (stage mannual is wrong!)
  fiducial(range_min 0.0 range_max 12.0 range_max_id 12.0 fov 360)
)

