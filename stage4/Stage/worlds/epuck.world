include "epuck.inc"
include "map.inc"

# speedup 5
# interval_sim 100 # 100 miliseconds between updates
# threads 4 # for multiple CPU cores

window
( 
  size [700.000 700.000] # in pixels
  scale 35
  show_data 1
)

